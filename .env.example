# ─────────────────────────────────────────────────────────────────────────────
# THE GOVERNANCE TRIBUNAL — Agent Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# AGENT_BACKEND options:
#   lmstudio   → LM Studio running locally  (Prism Bonsai, Llama, Mistral...)
#   ollama     → Ollama running locally
#   bob        → IBM Bob 2.0 local API
#   openai     → OpenAI cloud (needs real API key)
#   groq       → Groq cloud (needs real API key)
#   custom     → Any OpenAI-compatible URL you set in AGENT_BASE_URL
# ─────────────────────────────────────────────────────────────────────────────

# ── Which backend to use ──────────────────────────────────────────────────────
AGENT_BACKEND=lmstudio

# ── Which model to load ───────────────────────────────────────────────────────
# LM Studio:  match the model name shown in LM Studio's UI exactly
# Ollama:     run `ollama list` to see model names
# Bob 2.0:    bob-2.0
# OpenAI:     gpt-4o | gpt-4-turbo | gpt-3.5-turbo
AGENT_MODEL=prism-bonsai-27b

# ── API endpoint (override the default for your backend) ─────────────────────
# Leave blank to use the default for your chosen AGENT_BACKEND:
#   lmstudio  → http://localhost:1234/v1
#   ollama    → http://localhost:11434/v1
#   bob       → http://localhost:11435/v1
#   openai    → https://api.openai.com/v1
AGENT_BASE_URL=

# ── API key ───────────────────────────────────────────────────────────────────
# Local models (LM Studio, Ollama, Bob): leave as "none" or blank
# Cloud APIs (OpenAI, Groq): paste your real key here
AGENT_API_KEY=none

# ── Model tuning ─────────────────────────────────────────────────────────────
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=4096
AGENT_TIMEOUT=120

# ─────────────────────────────────────────────────────────────────────────────
# Other credentials (optional / stretch goals)
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_PROJECT_ID=your_project_id_here
